# ─────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ─────────────────────────────────────────────
# Dépendances
# ─────────────────────────────────────────────
node_modules/
jspm_packages/
web_modules/
bower_components/
vendor/

# ─────────────────────────────────────────────
# Variables d'environnement
# ─────────────────────────────────────────────
# Les fichiers .env contiennent des secrets : jamais versionnés.
# Exceptions :
#   .env.example → modèle de configuration, sans valeurs sensibles
#   .env.test    → configuration de l'environnement de test (aucun secret),
#                  requise par la CI GitHub Actions
.env
.env.*
!.env.example
!.env.test

# ─────────────────────────────────────────────
# Symfony (backend)
# ─────────────────────────────────────────────
/back/var/
/back/public/bundles/
/back/config/jwt/*.pem
/back/.php-cs-fixer.cache
/back/.phpunit.result.cache

# ─────────────────────────────────────────────
# Build frontend (Vite)
# ─────────────────────────────────────────────
dist/
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ─────────────────────────────────────────────
# Caches et fichiers temporaires
# ─────────────────────────────────────────────
.cache
.parcel-cache
.npm
.eslintcache
.stylelintcache
*.tsbuildinfo
.temp

# ─────────────────────────────────────────────
# Couverture de tests
# ─────────────────────────────────────────────
coverage/
*.lcov
.nyc_output
lib-cov

# ─────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────
pids
*.pid
*.seed
*.pid.lock

# ─────────────────────────────────────────────
# Éditeurs et OS
# ─────────────────────────────────────────────
.vscode-test
.idea/
.DS_Store
Thumbs.db
*.swp

# ─────────────────────────────────────────────
# Gestionnaires de paquets
# ─────────────────────────────────────────────
*.tgz
.yarn-integrity
.pnpm-store
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

